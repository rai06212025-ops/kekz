<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>kekzsite</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            color: white;
        }

        .logo {
            font-size: 48px;
            font-weight: bold;
            background: linear-gradient(90deg, #e94560, #ff6b6b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 10px;
            letter-spacing: 2px;
        }

        .site-name {
            font-size: 28px;
            color: #eee;
            margin-bottom: 40px;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .status-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 30px 40px;
            text-align: center;
            backdrop-filter: blur(10px);
        }

        .status-text {
            font-size: 18px;
            color: #4ade80;
            margin-bottom: 10px;
        }

        .sub-text {
            font-size: 14px;
            color: #888;
        }

        .circle {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #4ade80;
            margin-right: 8px;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.3; }
            100% { opacity: 1; }
        }
    </style>
</head>
<body>

    <div class="logo">kekzvpn</div>
    <div class="site-name">kekzsite</div>

    <div class="status-box">
        <span class="circle"></span>
        <p class="status-text">System Online</p>
        <p class="sub-text">Service is running smoothly</p>
    </div>

</body>
</html>

